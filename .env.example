# -------------------------------
# Database & Server
# -------------------------------
DATABASE_URL=postgres://user:password@host:port/dbname
PORT=3000

# -------------------------------
# JWT / Authentication
# -------------------------------
TOKEN_SECRET=your_token_secret_here
JWT_EXPIRES_IN=1d
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your_jwt_secret_here

# -------------------------------
# Kajabi API / Webhook
# -------------------------------
KAJABI_WEBHOOK_SECRET=your_webhook_secret
KAJABI_API_KEY=your_kajabi_api_key
KAJABI_API_SECRET=your_kajabi_api_secret

# -------------------------------
# Branding / External URLs
# -------------------------------
LOGO_URL=https://yourdomain.com/logo.png
FRONTEND_URL=https://yourfrontend.com

# -------------------------------
# OpenAI
# -------------------------------
OPENAI_API_KEY=sk-xxxx

# -------------------------------
# Python AI service (euphoriam-ai)
# -------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=120000
AI_SERVICE_INTERNAL_KEY=
USE_PYTHON_COACH=false
USE_PYTHON_MAP_RESISTANCE=false

# -------------------------------
# Brevo / SMTP / Email
# -------------------------------
BREVO_API_KEY=your_brevo_api_key
BREVO_LOGIN=your_brevo_login
BREVO_SMTP_KEY=your_smtp_key
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Name
SUPPORT_EMAIL=support@yourdomain.com

# -------------------------------
# Supabase Storage
# -------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET_REPORTS=reports
SUPABASE_URL=https://your-supabase-url.supabase.co

# -------------------------------
# ChromaDB Vector Database Configuration
# -------------------------------
# Priority: Cloud > Remote Server > Local > Ephemeral

# Option 1: ChromaDB Cloud (recommended)
CHROMA_DB_API_KEY=your_chroma_cloud_api_key
CHROMA_DB_TENANT=your_chroma_tenant
CHROMA_DB_DATABASE=your_chroma_database_name

# Option 2: Remote ChromaDB server
CHROMA_DB_URL=https://your_chroma_remote_server.com

# Option 3: Local persistent storage
CHROMA_DB_PATH=./chroma_db_storage

# If all above are empty, ephemeral (in-memory) mode will be used
